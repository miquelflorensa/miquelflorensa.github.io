---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import PresentationCard from "@components/PresentationCard.astro";
import { PRESENTATIONS } from "@consts";
import { PRESENTATIONS_TEXT, type Lang } from "@i18n";

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const t = PRESENTATIONS_TEXT[lang];
const presentations = [...PRESENTATIONS].sort((a, b) => new Date(b.DATE).valueOf() - new Date(a.DATE).valueOf());
---

<PageLayout title={t.title} description={t.description} lang={lang}>
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white">
        {t.title}
      </div>
      <ul class="animate flex flex-col gap-4">
        {
          presentations.map((presentation) => (
            <li>
              <PresentationCard presentation={presentation} lang={lang}/>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</PageLayout>
