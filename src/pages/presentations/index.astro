---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import PresentationCard from "@components/PresentationCard.astro";
import { PRESENTATIONS, PRESENTATIONS_PAGE } from "@consts";

const presentations = [...PRESENTATIONS].sort((a, b) => new Date(b.DATE).valueOf() - new Date(a.DATE).valueOf());
---

<PageLayout title={PRESENTATIONS_PAGE.TITLE} description={PRESENTATIONS_PAGE.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white">
        Presentations
      </div>
      <ul class="animate flex flex-col gap-4">
        {
          presentations.map((presentation) => (
            <li>
              <PresentationCard presentation={presentation}/>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</PageLayout>
